# kb-service 环境变量样例：复制为 .env 后填写
# 注意：.env 含密钥，禁止提交版本库（见 .gitignore）

# ---- 运行 ----
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=0
# 渠道 URL / iframe 代码的对外基址（如 https://ai.example.edu.cn）；留空取请求 Host
PUBLIC_BASE_URL=

# ---- 跨域（任务 3.9 嵌入 SDK）----
# 来源白名单，逗号分隔（如 https://www.example.edu.cn,https://xcb.example.edu.cn）；
# * 表示任意来源，此时不能携带 Cookie。身份透传走 Authorization 头，无需开启凭证。
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0
# 跨域可读的响应头（CSV 导出 / AI 标识）
CORS_EXPOSE_HEADERS=Content-Disposition,X-Export-Truncated,X-AI-Generated,X-AI-Label,X-AI-Produce-Id,X-AI-Label-Version

# ---- 存储：mysql | json ----
KB_STORE=json
# 本地 JSON 索引（KB_STORE=json 时使用）
STORE_PATH=./data/store.json

# ---- MySQL（KB_STORE=mysql 时必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nengxiaozhi
DB_CHARSET=utf8mb4

# ---- LLM（OpenAI 兼容，默认 DeepSeek；生产走 campus-ai-gateway）----
# gateway = 模型清单由网关下发（默认，能小智不维护第二份模型台账）
# local   = 直连「集成中心」当前启用的本地模型（离线/校内私有推理，C-05）
LLM_PROVIDER=gateway
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# gateway 模式可省略：省略时自动取网关 /v1/models 的第一个模型；local 模式忽略此项
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
# 无 key 联调：置 1 返回模拟回答
LLM_MOCK=0

# ---- 集成中心（任务 4.8 / C-05、M-A-07/10）----
# 连通性测试来源：mock = 内置确定性结果；live = 真实请求配置的端点
# 外部资源未就绪时保持 mock；接口开通后改 live，无需改代码
INTEGRATION_TEST_PROVIDER=mock
INTEGRATION_TEST_TIMEOUT=20
INTEGRATION_MCP_PROVIDER=mock
INTEGRATION_AGENT_PROVIDER=mock

# ---- 语音识别（任务 4.7）----
# mock = 内置固定转写（联调/演示）；openai = OpenAI 兼容 /audio/transcriptions
ASR_PROVIDER=mock
ASR_ENABLED=1
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_TIMEOUT=45
ASR_MAX_BYTES=10485760
ASR_MAX_SECONDS=60
# mock 模式的固定转写文本
ASR_MOCK_TEXT=校园网怎么开通？

# ---- 单点登录（任务 4.1）----
# CAS 服务端地址；留空 = 内置 mock CAS（联调/演示）
CAS_SERVER_URL=
CAS_LOGIN_PATH=/cas/login
CAS_VALIDATE_PATH=/cas/serviceValidate
# 回调 service 的对外基址；留空依次取 PUBLIC_BASE_URL / 当前请求地址
CAS_SERVICE_BASE=
CAS_TIMEOUT=10
# 已登记账号是否信任 CAS 角色属性（默认否，以本地 sys_user 绑定为准）
CAS_TRUST_ROLE_ATTRIBUTE=0
CAS_ROLE_MAP=student:本科生,undergraduate:本科生,graduate:研究生,teacher:教职工,staff:教职工,retired:离退休人员,visitor:访客

# ---- 导办事项与免登录票据（任务 4.5）----
GOV_ENABLED=1
# mock = 内置演示事项；http = 一网通办事项同步接口
GOV_SYNC_PROVIDER=mock
GOV_SYNC_URL=
GOV_SYNC_TOKEN=
GOV_SYNC_TIMEOUT=20
GOV_RECOMMEND_LIMIT=3
GOV_TICKET_TTL_SECONDS=120

# ---- 问数服务（任务 4.3）----
DQ_ENABLED=1
# mock = 内置确定性数据；http = 教务 / 一卡通真实接口
DQ_PROVIDER=mock
DQ_JW_BASE_URL=
DQ_JW_TOKEN=
DQ_CARD_BASE_URL=
DQ_CARD_TOKEN=
DQ_TIMEOUT=15
# 单次返回的最大明细行数（1–200）
DQ_MAX_ROWS=50

# ---- 通行查询智能体（任务 4.4）----
# mock = 内置确定性门禁流水；http = 门禁数据平台同步接口
ACCESS_SYNC_PROVIDER=mock
ACCESS_SYNC_URL=
ACCESS_SYNC_TOKEN=
ACCESS_SYNC_TIMEOUT=30
# 默认同步 / 看板窗口（天）与单次分析最大跨度（1–366）
ACCESS_SYNC_DAYS=30
ACCESS_MAX_RANGE_DAYS=90
# 单次同步流水上限与 CSV 单次导出行数上限
ACCESS_MAX_EVENTS=200000
ACCESS_EXPORT_LIMIT=10000

# ---- 客服体系（任务 4.6）----
# 总开关：关闭后转人工与工作台接口返回 503
SUPPORT_ENABLED=1
# 空库自动写入演示分组与坐席（已有数据不覆盖）
SUPPORT_AUTO_SEED=1
# WebSocket 心跳间隔（5–120 秒）与单条工单消息长度上限（50–5000）
SUPPORT_WS_HEARTBEAT=20
SUPPORT_MAX_MESSAGE=2000

# ---- 数据中台（任务 4.2 / I-02、M-SYS-02）----
# mock = 交付样例写入 data/data_center_outbox；http = 上报 / 拉取学校数据中台
DATA_CENTER_ENABLED=1
DATA_CENTER_PROVIDER=mock
DATA_CENTER_BASE_URL=
DATA_CENTER_TOKEN=
DATA_CENTER_TIMEOUT=20
DATA_CENTER_ORG_PATH=/org/export
DATA_CENTER_REPORT_PATH=/report
# 默认不上报问答正文；开启后先脱敏再截断到 500 字
DATA_CENTER_INCLUDE_CONTENT=0
DATA_CENTER_MAX_RECORDS=5000
# 定时水位：每日 2 点上报、3 点增量、周日 4 点全量（0=周一 … 6=周日）
DATA_CENTER_REPORT_HOUR=2
DATA_CENTER_INCREMENTAL_HOUR=3
DATA_CENTER_FULL_WEEKDAY=6
DATA_CENTER_FULL_HOUR=4
# 进程内调度默认关闭；生产建议由外部调度器调用 /api/admin/data-center/run-due
DATA_CENTER_SCHEDULER_ENABLED=0
DATA_CENTER_SCHEDULER_INTERVAL=60

# ---- 向量与检索 ----
MODEL_DIR=./models
# 与 kb-engine 对齐：ONNX 版 bge-small-zh-v1.5（512 维）
EMBED_MODEL=Xenova/bge-small-zh-v1.5
EMBED_DIM=512
# 嵌入 ONNX 线程数；0 = ORT 自动（空闲线程池会空转抢 CPU）
EMBED_THREADS=2
# 模型目录不存在时的下载源（HF 镜像）；置空则禁用下载，仅用本地模型
HF_ENDPOINT=https://hf-mirror.com
# 可选：显式指定嵌入模型目录（优先级最高），离线交付时使用
# KB_EMBED_DIR=D:/models/bge-small-zh-v1.5
# 精排默认关闭：8C16G 实测 8 并发首 token P95 3.8s，超过 3s 目标；开启后建议并发 ≤4
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_ENABLED=0
RERANK_TOPN=10
# 精排 ONNX intra-op 线程数；0 = ORT 自动
RERANK_THREADS=4
# 可选：显式指定精排模型目录
# KB_RERANK_DIR=D:/models/bge-reranker-v2-m3-ONNX
TOP_K=5
RRF_K=60
RETRIEVE_MODE=hybrid

# ---- 切片 ----
CHUNK_MAX=400
CHUNK_CARRY=60
CHUNK_MIN=40

# ---- 解析扩展（任务 1.10：12 格式 + OCR + 原图）----
# OCR 引擎：auto（按 rapidocr → tesseract 依次探测）/ rapidocr / tesseract / none
OCR_ENGINE=auto
# tesseract 语言包（中文需 chi_sim；rapidocr 内置中英，忽略此项）
OCR_LANG=chi_sim+eng
# 送 OCR 前把图片长边压到该值以内（大图会显著拖慢推理）
OCR_MAX_SIDE=2000
# 显式指定 tesseract 可执行文件（未加入 PATH 时）
TESSERACT_BIN=
# 显式指定 LibreOffice soffice（.doc/.ppt 转换用；未加入 PATH 时）
# Windows 常见路径：C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_BIN=
# soffice 单次转换超时（秒）
SOFFICE_TIMEOUT=120

# ---- 会话 ----
HISTORY_MAX_MESSAGES=20

# ---- 安全（任务 1.12 / 1.13）----
# 字段加密密钥（base64 32 字节或任意口令，经 SHA-256 派生）；生产必须设置
# 留空时退化为进程内临时密钥并告警（重启后无法解密历史密文）
AES_KEY=
# JWT 签名密钥；生产必须设置（留空则用进程内临时密钥）
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# 令牌校验开关：默认 false 便于开发/演示；生产必须置 1（管理接口才会拦截 401/403）
AUTH_ENABLED=0
# 限流开关（内存滑动窗口，零依赖）
RATE_LIMIT_ENABLED=1
# 每个窗口（60s）内单 IP 的请求上限，问答与管理接口共用
RATE_LIMIT_PER_MINUTE=60
# 敏感词双向检测（提问 + 回答），命中返回风控话术
SENSITIVE_CHECK_ENABLED=1
# 外部敏感词表（每行一词，# 开头为注释）；留空则只用内置意图词表
SENSITIVE_WORDS_FILE=

# ---- 目录 ----
KNOWLEDGE_DIR=../knowledge-base
UPLOAD_DIR=./uploads
