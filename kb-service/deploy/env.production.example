# kb-service 生产环境模板（任务 5.1）
# 复制为 kb-service/.env 后逐项替换 __SET_*__；.env 禁止提交版本库。
# 与开发环境的差异：MySQL 模式、鉴权开启、限流开启、真实网关、密钥显式注入。

# ---- 运行（只监听回环，外部一律经 Nginx HTTPS）----
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=0

# ---- 存储 ----
KB_STORE=mysql
STORE_PATH=./data/store.json

# ---- MySQL（端口只绑定 127.0.0.1）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=__SET_DB_PASSWORD__
DB_NAME=nengxiaozhi
DB_CHARSET=utf8mb4

# ---- LLM 网关（唯一模型来源；不填厂商地址与厂商 Key）----
# gateway = 网关下发（生产默认）；local = 直连「集成中心」启用的本地模型（离线演示）
LLM_PROVIDER=gateway
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=__SET_GATEWAY_BUSINESS_KEY__
# 留空 = 使用网关 /v1/models 的默认路由
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_MOCK=0

# ---- 集成中心（任务 4.8；本地模型 / MCP / 第三方智能体）----
# 外部资源未就绪时保持 mock；联调/验收切 live（真实请求配置的端点）
INTEGRATION_TEST_PROVIDER=mock
INTEGRATION_TEST_TIMEOUT=20
INTEGRATION_MCP_PROVIDER=mock
INTEGRATION_AGENT_PROVIDER=mock

# ---- 语音识别（任务 4.7；接口未就绪时保留 mock，仅用于演示）----
ASR_PROVIDER=mock
ASR_ENABLED=1
ASR_BASE_URL=__SET_ASR_BASE_URL__
ASR_API_KEY=__SET_ASR_API_KEY__
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_TIMEOUT=45
ASR_MAX_BYTES=10485760
ASR_MAX_SECONDS=60
ASR_MOCK_TEXT=校园网怎么开通？

# ---- 单点登录（任务 4.1；留空 = mock CAS，生产填真实服务）----
CAS_SERVER_URL=
CAS_LOGIN_PATH=/cas/login
CAS_VALIDATE_PATH=/cas/serviceValidate
CAS_SERVICE_BASE=
CAS_TIMEOUT=10
CAS_TRUST_ROLE_ATTRIBUTE=0
CAS_ROLE_MAP=student:本科生,undergraduate:本科生,graduate:研究生,teacher:教职工,staff:教职工,retired:离退休人员,visitor:访客

# ---- 导办事项（任务 4.5）----
GOV_ENABLED=1
GOV_SYNC_PROVIDER=mock
GOV_SYNC_URL=
GOV_SYNC_TOKEN=
GOV_SYNC_TIMEOUT=20
GOV_RECOMMEND_LIMIT=3
GOV_TICKET_TTL_SECONDS=120

# ---- 问数服务（任务 4.3；真实接口未就绪时保留 mock）----
DQ_ENABLED=1
DQ_PROVIDER=mock
DQ_JW_BASE_URL=
DQ_JW_TOKEN=
DQ_CARD_BASE_URL=
DQ_CARD_TOKEN=
DQ_TIMEOUT=15
DQ_MAX_ROWS=50

# ---- 通行查询（任务 4.4）----
ACCESS_SYNC_PROVIDER=mock
ACCESS_SYNC_URL=
ACCESS_SYNC_TOKEN=
ACCESS_SYNC_TIMEOUT=30
ACCESS_SYNC_DAYS=30
ACCESS_MAX_RANGE_DAYS=90
ACCESS_MAX_EVENTS=200000
ACCESS_EXPORT_LIMIT=10000

# ---- 客服体系（任务 4.6；WebSocket 需 Nginx 升级头，见 nginx 模板）----
SUPPORT_ENABLED=1
SUPPORT_AUTO_SEED=0
SUPPORT_WS_HEARTBEAT=20
SUPPORT_MAX_MESSAGE=2000

# ---- 数据中台（任务 4.2；先执行 tools/migrate_data_center_4_2.py）----
DATA_CENTER_ENABLED=1
DATA_CENTER_PROVIDER=mock
# 真实对接时填学校数据中台地址与业务令牌；令牌只写服务端 .env
DATA_CENTER_BASE_URL=
DATA_CENTER_TOKEN=
DATA_CENTER_TIMEOUT=20
DATA_CENTER_ORG_PATH=/org/export
DATA_CENTER_REPORT_PATH=/report
# 默认不上报问答正文；确需上报时先脱敏再截断
DATA_CENTER_INCLUDE_CONTENT=0
DATA_CENTER_MAX_RECORDS=5000
DATA_CENTER_REPORT_HOUR=2
DATA_CENTER_INCREMENTAL_HOUR=3
DATA_CENTER_FULL_WEEKDAY=6
DATA_CENTER_FULL_HOUR=4
# 生产建议由外部调度器调用 /api/admin/data-center/run-due；进程内调度默认关闭
DATA_CENTER_SCHEDULER_ENABLED=0
DATA_CENTER_SCHEDULER_INTERVAL=60

# ---- 向量与检索（离线交付时显式指向随包模型目录）----
MODEL_DIR=./models
EMBED_MODEL=Xenova/bge-small-zh-v1.5
EMBED_DIM=512
HF_ENDPOINT=
# KB_EMBED_DIR=/opt/nengxiaozhi/models/bge-small-zh-v1.5
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_ENABLED=1
RERANK_TOPN=30
# KB_RERANK_DIR=/opt/nengxiaozhi/models/bge-reranker-v2-m3-ONNX
TOP_K=5
RRF_K=60
RETRIEVE_MODE=hybrid

# ---- 切片 ----
CHUNK_MAX=400
CHUNK_CARRY=60
CHUNK_MIN=40

# ---- 解析扩展 ----
OCR_ENGINE=auto
OCR_LANG=chi_sim+eng
OCR_MAX_SIDE=2000
TESSERACT_BIN=
SOFFICE_BIN=
SOFFICE_TIMEOUT=120

# ---- 会话 ----
HISTORY_MAX_MESSAGES=20

# ---- 安全（生产必填；生成命令：
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ）----
AES_KEY=__SET_AES_KEY__
JWT_SECRET=__SET_JWT_SECRET__
JWT_EXPIRE_MINUTES=720
AUTH_ENABLED=true
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=60
SENSITIVE_CHECK_ENABLED=1
SENSITIVE_WORDS_FILE=

# ---- 目录 ----
KNOWLEDGE_DIR=../knowledge-base
UPLOAD_DIR=./uploads
